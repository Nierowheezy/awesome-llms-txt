    "test:invalid": "node cli.js ../examples/invalid-llms.txt"
  },
  "keywords": [
    "llms-txt",
    "llms.txt",
    "validator",
    "ai",
    "documentation",
    "llm",
    "claude",
    "chatgpt",
    "answer-ai"
  ],
