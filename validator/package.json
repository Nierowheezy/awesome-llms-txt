{
  "name": "llms-txt-validator",
  "version": "1.0.0",
  "description": "Validate your llms.txt files against the Answer.AI specification",
  "main": "cli.js",
  "bin": {
    "llms-txt-validator": "./cli.js"
  },
  "scripts": {
    "test": "node cli.js ../examples/valid-llms.txt",
